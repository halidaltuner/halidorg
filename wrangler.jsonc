// Edge Worker + Go container (ADR-001). Top level is the local env (`wrangler dev`),
// which accepts any resource id. Staging and prod ids were printed by the create
// commands in docs/environments.md.
// Bindings and vars are not inherited by envs, so each env repeats them in full.
// Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, GITHUB_TOKEN) go through
// `wrangler secret put` or `.dev.vars`, never here.
{
  "$schema": "./worker/node_modules/wrangler/config-schema.json",
  "name": "halidorg",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "App",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "App" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App"] }],

  "kv_namespaces": [{ "binding": "PAGES", "id": "local-pages" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "halidorg-local",
      "database_id": "local-db",
      "migrations_dir": "migrations"
    },
    // Search index (ADR-010): FTS5 in its own database so the main DB stays exportable.
    {
      "binding": "SEARCH",
      "database_name": "halidorg-search-local",
      "database_id": "local-search",
      "migrations_dir": "migrations-search"
    }
  ],
  // Jobs (Phase 1.3): the container produces through the bridge, this Worker
  // consumes and delivers to the container. 3 retries, then the DLQ.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "halidorg-jobs-local" }],
    "consumers": [
      {
        "queue": "halidorg-jobs-local",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "halidorg-jobs-dlq-local"
      }
    ]
  },
  "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "halidorg-media-local" },
        // Backups (Phase 9.1): never served; the weekly export writes here, the
        // nightly D1 dump comes from .github/workflows/backup.yml.
        { "binding": "BACKUPS", "bucket_name": "halidorg-backups-local" }
      ],

  // Cron (Phase 4.4): enqueue jobs, never call the container (worker/src/jobs.ts SCHEDULES).
  "triggers": { "crons": ["17 */6 * * *", "7 0 * * *", "41 1 * * 0"] },

  // DECKS_ORIGIN (ADR-007): presentation decks are served only on this host.
  // Locally 127.0.0.1 is a different origin from localhost on the same Worker.
  "vars": {
    "APP_ENV": "local",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "DECKS_ORIGIN": "http://127.0.0.1:8787"
  },

  "env": {
    "staging": {
      "name": "halidorg-staging",
      "routes": [
        { "pattern": "staging.halid.org", "custom_domain": true },
        // The decks origin (ADR-007): the same Worker, deck files only.
        { "pattern": "decks-staging.halid.org", "custom_domain": true }
      ],
      "containers": [
        {
          "class_name": "App",
          "image": "./Dockerfile",
          "instance_type": "lite",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "APP", "class_name": "App" }]
      },
      "kv_namespaces": [{ "binding": "PAGES", "id": "fa8629b429b34621bacdb30d912fc88f" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "halidorg-staging",
          "database_id": "06d5c0e6-7d18-4db5-935f-a8f45d24cbed",
          "migrations_dir": "migrations"
        },
        // Search index (ADR-010): FTS5 in its own database so the main DB stays exportable.
        {
          "binding": "SEARCH",
          "database_name": "halidorg-search-staging",
          "database_id": "d6c10762-47ac-4a2e-869e-4466f69ddf39",
          "migrations_dir": "migrations-search"
        }
      ],
      // Jobs (Phase 1.3): the container produces through the bridge, this Worker
      // consumes and delivers to the container. 3 retries, then the DLQ.
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "halidorg-jobs-staging" }],
        "consumers": [
          {
            "queue": "halidorg-jobs-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "halidorg-jobs-dlq-staging"
          }
        ]
      },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "halidorg-media-staging" },
        // Backups (Phase 9.1): never served; the weekly export writes here, the
        // nightly D1 dump comes from .github/workflows/backup.yml.
        { "binding": "BACKUPS", "bucket_name": "halidorg-backups-staging" }
      ],
      "triggers": { "crons": ["17 */6 * * *", "7 0 * * *", "41 1 * * 0"] },
      "vars": {
        "APP_ENV": "staging",
        "PUBLIC_ORIGIN": "https://staging.halid.org",
        "DECKS_ORIGIN": "https://decks-staging.halid.org"
      }
    },

    "prod": {
      "name": "halidorg-prod",
      // No halid.org route until the Phase 3 cutover: a custom_domain here would
      // take the domain from Ghost on the first prod deploy. Reachable on workers.dev.
      "workers_dev": true,
      "containers": [
        {
          "class_name": "App",
          "image": "./Dockerfile",
          "instance_type": "lite",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "APP", "class_name": "App" }]
      },
      "kv_namespaces": [{ "binding": "PAGES", "id": "717e354737f142aaab2d86b381873270" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "halidorg-prod",
          "database_id": "afcbea10-e0d6-46ab-bf01-3c9f5d24dcd9",
          "migrations_dir": "migrations"
        },
        // Search index (ADR-010): FTS5 in its own database so the main DB stays exportable.
        {
          "binding": "SEARCH",
          "database_name": "halidorg-search-prod",
          "database_id": "e0381f89-ed14-40f3-ac58-36e06c29d9ae",
          "migrations_dir": "migrations-search"
        }
      ],
      // Jobs (Phase 1.3): the container produces through the bridge, this Worker
      // consumes and delivers to the container. 3 retries, then the DLQ.
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "halidorg-jobs-prod" }],
        "consumers": [
          {
            "queue": "halidorg-jobs-prod",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "halidorg-jobs-dlq-prod"
          }
        ]
      },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "halidorg-media-prod" },
        // Backups (Phase 9.1): never served; the weekly export writes here, the
        // nightly D1 dump comes from .github/workflows/backup.yml.
        { "binding": "BACKUPS", "bucket_name": "halidorg-backups-prod" }
      ],
      "triggers": { "crons": ["17 */6 * * *", "7 0 * * *", "41 1 * * 0"] },
      "vars": {
        "APP_ENV": "prod",
        // Admin login on prod needs this origin and its own OAuth client (Phase 3).
        "PUBLIC_ORIGIN": "https://halid.org",
        // Its custom domain joins the halid.org route at the Phase 3 cutover.
        "DECKS_ORIGIN": "https://decks.halid.org"
      }
    }
  }
}
